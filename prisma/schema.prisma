// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trip {
  id           String            @id @default(uuid())
  name         String
  destination  String?
  startDate    DateTime?
  endDate      DateTime?
  baseCurrency String            @default("USD")
  budgetLimit  Int?              // stored in cents
  createdBy    String            // clerk userId
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  participants TripParticipant[]
  expenses     Expense[]
}

model TripParticipant {
  id        String   @id @default(uuid())
  tripId    String
  userId    String   // clerk userId
  email     String?
  name      String?
  role      String   @default("member") // owner, member
  status    String   @default("joined") // invited, joined
  joinedAt  DateTime @default(now())
  
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Expense {
  id              String         @id @default(uuid())
  tripId          String
  description     String
  amount          Int            // in cents
  currency        String         // Original expense currency
  date            DateTime       @default(now())
  category        String?
  paidByUserId    String         // clerk userId
  splitType       String         @default("EQUAL")
  status          String         @default("active")
  notes           String?
  receiptUrl      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  trip            Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  splits          ExpenseSplit[]
}

model ExpenseSplit {
  id        String   @id @default(uuid())
  expenseId String
  userId    String   // clerk userId of the person who owes this share
  amount    Int      // Share amount in cents
  isPaid    Boolean  @default(false)

  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}
