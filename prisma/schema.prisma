// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trip {
  id           String            @id @default(uuid())
  name         String
  destination  String?
  startDate    DateTime?
  endDate      DateTime?
  baseCurrency String            @default("USD")
  budgetLimit  Int?              // stored in cents
  createdBy    String            // clerk userId
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  participants TripParticipant[]
  expenses     Expense[]
}

model TripParticipant {
  id        String   @id @default(uuid())
  tripId    String
  userId    String   // clerk userId
  email     String?
  name      String?
  role      String   @default("member") // owner, member
  status    String   @default("joined") // invited, joined
  joinedAt  DateTime @default(now())
  
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Expense {
  id              String         @id @default(uuid())
  tripId          String
  description     String
  amount          Int            // in cents
  currency        String         // Original expense currency
  date            DateTime       @default(now())
  category        String?
  paidByUserId    String         // clerk userId
  splitType       String         @default("EQUAL")
  status          String         @default("active")
  notes           String?
  receiptUrl      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  trip            Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  splits          ExpenseSplit[]
}

model ExpenseSplit {
  id        String   @id @default(uuid())
  expenseId String
  userId    String   // clerk userId of the person who owes this share
  amount    Int      // Share amount in cents
  isPaid    Boolean  @default(false)

  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

// AI Trip Planner - Saved Trips (separate from expense tracking)
model SavedTrip {
  id               String   @id @default(uuid())
  userId           String   // clerk userId
  title            String
  destination      String
  thumbnailUrl     String?
  
  // AI Planner State (JSON)
  plannerState     String   // JSON string: routeFlow, mapPoints, dates, dayPlans, etc.
  chatHistory      String   // JSON string: all chat messages
  transportation   String?  // JSON string: flight/transport data
  accommodation    String?  // JSON string: hotel/accommodation data
  safetyAlert      String?  // JSON string: safety information
  thingsToKnow     String?  // JSON string: destination tips
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([userId])
}

// Community UGC - User-Generated Trip Content
model CommunityTrip {
  id              String   @id @default(uuid())
  userId          String   // clerk userId
  userName        String
  userAvatar      String?
  
  // Trip Basic Info
  title           String
  destination     String
  thumbnailUrl    String
  duration        String   // e.g. "5 days & 4 nights"
  rating          Float    @default(0)
  description     String?  // Short description
  
  // Trip Content (reuse SavedTrip structure)
  plannerState    String   // JSON: complete itinerary data
  highlights      String   // JSON array: trip highlights
  dayGuides       String?  // JSON: daily travel guides with user experiences
  
  // Statistics
  viewCount       Int      @default(0)
  importCount     Int      @default(0)
  commentCount    Int      @default(0)
  likeCount       Int      @default(0)
  
  // Source Tracking (for iteration loop)
  originalTripId  String?  // If improved from another trip
  sourceType      String?  // "ai_generated", "community_import", "scratch"
  
  // Status
  isPublished     Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  comments        Comment[]
  likes           Like[]
  signals         UGCSignal[]
  
  @@index([userId])
  @@index([destination])
  @@index([rating])
}

model Comment {
  id              String        @id @default(uuid())
  tripId          String
  trip            CommunityTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  userId          String        // clerk userId
  userName        String
  userAvatar      String?
  content         String
  
  // Reply support
  parentId        String?       // null for top-level comments
  parent          Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Comment[]     @relation("CommentReplies")
  
  // Likes
  likes           CommentLike[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([tripId])
  @@index([parentId])
}

model CommentLike {
  id              String        @id @default(uuid())
  commentId       String
  comment         Comment       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  
  userId          String        // clerk userId
  
  createdAt       DateTime      @default(now())
  
  @@unique([commentId, userId])
  @@index([commentId])
}

model Like {
  id              String        @id @default(uuid())
  tripId          String
  trip            CommunityTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  userId          String        // clerk userId
  
  createdAt       DateTime      @default(now())
  
  @@unique([tripId, userId])
  @@index([tripId])
}

// UGC Signals - AI-generated insights from user comments
model UGCSignal {
  id              String        @id @default(uuid())
  tripId          String
  trip            CommunityTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  // Signal Classification
  signalType      String        // "positive", "negative", "suggestion"
  category        String        // "accommodation", "transportation", "food", "activity", "timing", "cost", "safety", "other"
  
  // Signal Content
  title           String        // Short summary (e.g., "Hotel location concern")
  content         String        // Detailed description
  actionable      String?       // Suggested action (e.g., "Consider booking hotels near MRT stations")
  
  // Metadata
  confidence      Float         @default(0.8) // AI confidence score (0-1)
  commentCount    Int           @default(1)   // Number of comments this signal is based on
  commentIds      String        // JSON array of comment IDs
  
  // Impact Assessment
  priority        String        @default("medium") // "high", "medium", "low"
  impactArea      String?       // Which part of trip is affected (e.g., "Day 2 afternoon")
  
  // Status
  isActive        Boolean       @default(true)
  reviewedBy      String?       // Admin/Guide user ID who reviewed this
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([tripId])
  @@index([signalType])
  @@index([category])
  @@index([priority])
}
