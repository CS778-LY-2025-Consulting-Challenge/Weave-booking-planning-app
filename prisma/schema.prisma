// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trip {
  id           String            @id @default(uuid())
  name         String
  destination  String?
  startDate    DateTime?
  endDate      DateTime?
  baseCurrency String            @default("USD")
  budgetLimit  Int?              // stored in cents
  createdBy    String            // clerk userId
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  participants TripParticipant[]
  expenses     Expense[]
}

model TripParticipant {
  id        String   @id @default(uuid())
  tripId    String
  userId    String   // clerk userId
  email     String?
  name      String?
  role      String   @default("member") // owner, member
  status    String   @default("joined") // invited, joined
  joinedAt  DateTime @default(now())
  
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}

model Expense {
  id              String         @id @default(uuid())
  tripId          String
  description     String
  amount          Int            // in cents
  currency        String         // Original expense currency
  date            DateTime       @default(now())
  category        String?
  paidByUserId    String         // clerk userId
  splitType       String         @default("EQUAL")
  status          String         @default("active")
  notes           String?
  receiptUrl      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  trip            Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  splits          ExpenseSplit[]
}

model ExpenseSplit {
  id        String   @id @default(uuid())
  expenseId String
  userId    String   // clerk userId of the person who owes this share
  amount    Int      // Share amount in cents
  isPaid    Boolean  @default(false)

  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
}

// AI Trip Planner - Saved Trips (separate from expense tracking)
model SavedTrip {
  id               String   @id @default(uuid())
  userId           String   // clerk userId
  title            String
  destination      String
  thumbnailUrl     String?
  
  // AI Planner State (JSON)
  plannerState     String   // JSON string: routeFlow, mapPoints, dates, dayPlans, etc.
  chatHistory      String   // JSON string: all chat messages
  transportation   String?  // JSON string: flight/transport data
  accommodation    String?  // JSON string: hotel/accommodation data
  safetyAlert      String?  // JSON string: safety information
  thingsToKnow     String?  // JSON string: destination tips
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  @@index([userId])
}

// Community UGC - User-Generated Trip Content
model CommunityTrip {
  id              String   @id @default(uuid())
  userId          String   // clerk userId
  userName        String
  userAvatar      String?
  
  // Trip Basic Info
  title           String
  destination     String
  thumbnailUrl    String
  duration        String   // e.g. "5 days & 4 nights"
  rating          Float    @default(0)
  description     String?  // Short description
  
  // Trip Content (reuse SavedTrip structure)
  plannerState    String   // JSON: complete itinerary data
  highlights      String   // JSON array: trip highlights
  
  // Statistics
  viewCount       Int      @default(0)
  importCount     Int      @default(0)
  commentCount    Int      @default(0)
  likeCount       Int      @default(0)
  
  // Source Tracking (for iteration loop)
  originalTripId  String?  // If improved from another trip
  sourceType      String?  // "ai_generated", "community_import", "scratch"
  
  // Status
  isPublished     Boolean  @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  comments        Comment[]
  likes           Like[]
  
  @@index([userId])
  @@index([destination])
  @@index([rating])
}

model Comment {
  id              String        @id @default(uuid())
  tripId          String
  trip            CommunityTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  userId          String        // clerk userId
  userName        String
  userAvatar      String?
  content         String
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@index([tripId])
}

model Like {
  id              String        @id @default(uuid())
  tripId          String
  trip            CommunityTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  userId          String        // clerk userId
  
  createdAt       DateTime      @default(now())
  
  @@unique([tripId, userId])
  @@index([tripId])
}
